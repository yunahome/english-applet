{
  "name": "duolingo-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "模仿多邻国的英语学习闯关小程序，基于 Taro 4 + React + TS + Vite，一套代码编译到微信/抖音小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:course": "node scripts/build_course.cjs",
    "build:weapp": "taro build --type weapp && cp -R src/assets/audio dist/assets/audio",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.1.9",
    "@tarojs/helper": "4.1.9",
    "@tarojs/plugin-framework-react": "4.1.9",
    "@tarojs/plugin-platform-tt": "4.1.9",
    "@tarojs/plugin-platform-weapp": "4.1.9",
    "@tarojs/react": "4.1.9",
    "@tarojs/runtime": "4.1.9",
    "@tarojs/shared": "4.1.9",
    "@tarojs/taro": "4.1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tarojs/cli": "4.1.9",
    "@tarojs/vite-runner": "4.1.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-preset-taro": "4.1.9",
    "sass": "^1.77.0",
    "typescript": "^5.4.5",
    "vite": "^4.5.3",
    "xlsx": "^0.18.5"
  },
  "allowScripts": {
    "@tarojs/cli@4.1.9": true,
    "@tarojs/binding@4.1.9": true,
    "@swc/core@1.3.96": true,
    "esbuild@0.21.5": true,
    "esbuild@0.18.20": true,
    "core-js@3.51.0": true,
    "core-js-pure@3.51.0": true,
    "@parcel/watcher@2.6.0": true
  }
}
